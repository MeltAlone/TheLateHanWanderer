      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LateHan.Game.Domain\LateHan.Game.Domain.csproj" />
    <ProjectReference Include="..\LateHan.Game.Simulation\LateHan.Game.Simulation.csproj" />
    <ProjectReference Include="..\LateHan.Game.Content\LateHan.Game.Content.csproj" />

  "propositions": [
    {"id": "proposition.general_office_requests_status", "text": "大将军府询问司隶校尉署今日准备进度。", "objective_status": "authored_statement", "provenance": [{"kind": "gameplay_assumption", "assumption_id": "assumption.proposition.status_request", "reason": "低敏感度差遣用于第一条玩家因果链。", "applies_to": ["text", "objective_status"]}]},
    {"id": "proposition.palace_requests_he_jin_audience", "text": "宫中请求何进尽快入内议事。", "objective_status": "planned_not_yet_issued", "provenance": [{"kind": "gameplay_assumption", "assumption_id": "assumption.proposition.palace_audience", "reason": "是否正式发出由张让计划和宫中条件决定。", "applies_to": ["text", "objective_status"]}]},
    {"id": "proposition.north_gate_military_traffic_rising", "text": "北门所见军用人马往来较平日增加。", "objective_status": "locally_supported", "provenance": [{"kind": "bounded_inference", "basis_claim_ids": ["claim.189.ding_yuan.mengjin_pressure"], "reason": "压力方向支持交通增加的可能，但强度为场景假设。", "applies_to": ["text", "objective_status"]}]},
    {"id": "proposition.qiao_mao_holds_chenggao", "text": "桥瑁以东郡太守身份暂屯成皋。", "objective_status": "historically_asserted", "provenance": [{"kind": "historical_claim", "claim_ids": ["claim.189.qiao_mao.chenggao_garrison"], "applies_to": ["text", "objective_status"]}]},
    {"id": "proposition.external_forces_can_pressure_palace", "text": "外兵接近京师能够迫使宫中接受诛除宦官。", "objective_status": "contested_prediction", "provenance": [{"kind": "bounded_inference", "basis": "research.slice.189.luoyang_crisis", "reason": "历史参与者可以如此判断，但它不是世界必然规律。", "applies_to": ["text", "objective_status"]}]},
    {"id": "proposition.delay_increases_eunuch_response_risk", "text": "继续拖延会给受威胁的宦官更多反制时间。", "objective_status": "conditionally_supported", "provenance": [{"kind": "bounded_inference", "basis": "research.slice.189.luoyang_crisis", "reason": "危机中的时间竞争推断，效果由实际消息和计划决定。", "applies_to": ["text", "objective_status"]}]},
    {"id": "proposition.he_jin_intends_mass_purge", "text": "何进将立即尽诛宫中宦官。", "objective_status": "overstated_rumor", "provenance": [{"kind": "gameplay_assumption", "assumption_id": "assumption.proposition.purge_rumor", "reason": "用过度概括的传言验证错误认知和威胁反应。", "applies_to": ["text", "objective_status"]}]},
    {"id": "proposition.empress_dowager_can_be_persuaded", "text": "何太后仍可能在家族与宫廷压力下改变决定。", "objective_status": "uncertain_prediction", "provenance": [{"kind": "bounded_inference", "basis": "research.slice.189.luoyang_crisis", "reason": "人物信念，不是锁定结果。", "applies_to": ["text", "objective_status"]}]},
    {"id": "proposition.palace_household_requires_eunuch_service", "text": "彻底清除宫中宦官会破坏太后依赖的宫廷服务与权力网络。", "objective_status": "partially_supported", "provenance": [{"kind": "bounded_inference", "basis": "research.slice.189.luoyang_crisis", "reason": "把制度依赖作为太后反对行动的一个动机，而非唯一原因。", "applies_to": ["text", "objective_status"]}]},
    {"id": "proposition.dong_zhuo_near_luoyang", "text": "董卓所部已接近雒阳西面。", "objective_status": "imprecise_but_supported", "provenance": [{"kind": "historical_claim", "claim_ids": ["claim.189.dong_zhuo.sunset_pavilion"], "applies_to": ["text", "objective_status"]}]},
    {"id": "proposition.north_gate_closed", "text": "北门已经完全关闭。", "objective_status": "false_at_start", "provenance": [{"kind": "gameplay_assumption", "assumption_id": "assumption.proposition.false_gate_rumor", "reason": "初始假传言用于验证查证、传播和后果。", "applies_to": ["text", "objective_status"]}]},
    {"id": "proposition.palace_credential_required", "text": "仅有大将军府书吏凭记不足以进入宫中内层。", "objective_status": "true_under_initial_rules", "provenance": [{"kind": "gameplay_assumption", "assumption_id": "assumption.proposition.palace_access", "reason": "把门禁规则转化为角色可掌握的知识。", "applies_to": ["text", "objective_status"]}]},
    {"id": "proposition.wet_season_may_delay_roads", "text": "连月雨水可能使远途行程比常时更慢。", "objective_status": "bounded_risk", "provenance": [{"kind": "bounded_inference", "basis_claim_ids": ["claim.189.summer.prolonged_rain"], "reason": "不推断丁卯日雒阳必然降雨。", "applies_to": ["text", "objective_status"]}]},
    {"id": "proposition.qiao_mao_is_chenggao_administrator", "text": "桥瑁是成皋本地长官。", "objective_status": "false", "provenance": [{"kind": "historical_claim", "claim_ids": ["claim.189.qiao_mao.chenggao_garrison"], "reason": "专门保留一个历史上不成立的常见误解。", "applies_to": ["text", "objective_status"]}]}
